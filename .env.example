# Environment variables for Motes
# Copy to .env and fill in your values

# App
MOTES_DEBUG=true

# LLM Provider
MOTES_LLM_PROVIDER=mock
MOTES_LLM_MODEL=mock-model
MOTES_LLM_API_KEY=
MOTES_LLM_BASE_URL=

# Database (default for docker-compose dev)
MOTES_DATABASE_URL=postgresql+asyncpg://motes:motes_dev@localhost:5432/motes

# Redis
MOTES_REDIS_URL=redis://localhost:6379/0

# OpenTelemetry
MOTES_OTEL_ENABLED=false
MOTES_OTEL_EXPORTER_ENDPOINT=http://localhost:4317
