# Motes Backend Configuration
# Copy this to .env and fill in your values

# Database (Docker Compose default)
MOTES_DATABASE_URL=postgresql+asyncpg://motes:motes_dev@localhost:5433/motes
MOTES_REDIS_URL=redis://localhost:6380/0

# Secret key for JWT tokens (auto-generated if not set, but set it to survive restarts)
MOTES_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# Optional: Brave Search API key (falls back to DuckDuckGo if not set)
# BRAVE_SEARCH_API_KEY=

# Optional: Service API keys (can also be set via the web UI at /services)
# GITHUB_TOKEN=
# SLACK_BOT_TOKEN=
# TODOIST_API_KEY=
# NOTION_API_KEY=
# SPOTIFY_TOKEN=
# HA_URL=
# HA_TOKEN=
# OUTLOOK_ACCESS_TOKEN=
# AMADEUS_API_KEY=
# AMADEUS_API_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
